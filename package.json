{
    "name": "api-specs-viewer",
    "version": "1.0.0",
    "description": "OpenAPI specifications viewer",
    "scripts": {
        "build": "node build.js",
        "dev": "pnpm build && pnpm exec http-server dist -p 8080",
        "clean": "rm -rf dist",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"build.js\" \"src/**/*.{js,css,html}\" \"tests/**/*.{js,mjs}\" \"eslint.config.js\" \"package.json\"",
        "format:check": "prettier --check \"build.js\" \"src/**/*.{js,css,html}\" \"tests/**/*.{js,mjs}\" \"eslint.config.js\" \"package.json\"",
        "test": "node --test --test-isolation=none"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "fs-extra": "^11.4.1",
        "glob": "^13.0.6",
        "globals": "^17.13.0",
        "http-server": "^14.1.1",
        "prettier": "^3.9.10"
    }
}
